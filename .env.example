# OpenAI
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
# OPENAI_MODEL - optional. The app uses gpt-6-luna for every step and automatically falls back to
# gpt-4.1-mini and then gpt-4o-mini if that model is unavailable for your API key.
# IMPORTANT: if OPENAI_MODEL is set (locally or in Netlify) it takes priority over the default,
# so remove it - or set it to gpt-6-luna - when you want the default model.
# OPENAI_MODEL=gpt-6-luna

# Database (Supabase)
DATABASE_URL=postgresql://postgres.<project-ref>:<your-password>@<your-host>:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.<project-ref>:<your-password>@<your-host>:5432/postgres?sslmode=require

# Database (local Postgres alternative)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_wizard
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/research_wizard

# App
NEXT_PUBLIC_APP_URL=http://localhost:3011
AUTH_SECRET=replace_with_a_long_random_secret
# Public URL of the deployment (required behind proxies / on Netlify), e.g. https://your-site.netlify.app
# AUTH_URL=http://localhost:3011
AUTH_GOOGLE_ID=replace_with_google_client_id
AUTH_GOOGLE_SECRET=replace_with_google_client_secret
S2_API_KEY=your_semantic_scholar_api_key

# Telemetry dashboard (/telemetry): comma-separated emails allowed to view it.
# If empty, any signed-in user can view it.
# TELEMETRY_ADMIN_EMAILS=you@example.com
